# Optional — the game runs fully offline (local saves, hot-seat multiplayer, rule-based historian) without these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# NEVER put an AI API key here. Set ANTHROPIC_API_KEY as a Supabase Edge Function secret instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-...

# Ism-familya ro'yxati uchun test-tizimi serveri manzili (ixtiyoriy)
VITE_VISITORS_API=

# --- Voice-over of the opening cutscene (Vercel function api/tts.js, ElevenLabs) — SERVER-SIDE ONLY -------------------
# Set these in Vercel → Project → Settings → Environment Variables (NOT with a VITE_ prefix, NOT in the frontend), then redeploy.
# Without a key the cutscene still plays full-screen with animation, subtitles and its built-in music, just without the spoken narrator.
ELEVENLABS_API_KEY=
# Optional: voice for every language (default: George, "JBFqnCBsd6RMkjVDRZzb"), and per-language overrides
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_UZ=
ELEVENLABS_VOICE_RU=
ELEVENLABS_VOICE_EN=
# Optional: model (default eleven_v3 — it supports Uzbek, Russian and English; eleven_v4 is tried as a fallback)
ELEVENLABS_MODEL=
